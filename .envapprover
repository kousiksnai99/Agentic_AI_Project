import time
from openai import AzureOpenAI

# ---------------------------------------------------------
# Direct LLM Call (Correct SDK)
# ---------------------------------------------------------

# Hardcode credentials here
AZURE_OPENAI_ENDPOINT = "https://aifoundry-rjteh-ais-swce-poc.services.ai.azure.com"
AZURE_OPENAI_KEY = "G3T2HOKaVUTwDmDkV0OaEOrlsjO90eJPfaWZErYpODlIvzuOhEMoJQQJ99BJACfhMk5XJ3w3AAAAACOG8gdK"              # <-- Add your key
DEPLOYMENT_NAME = "gpt-5-mini"                 # <-- Your model deployment name

def direct_llm_call():
    print("=== DIRECT LLM CALL ===")

    client = AzureOpenAI(
        api_key=AZURE_OPENAI_KEY,
        azure_endpoint=AZURE_OPENAI_ENDPOINT,
        api_version="2024-05-01-preview"
    )

    start = time.time()

    response = client.chat.completions.create(
        model=DEPLOYMENT_NAME,
        messages=[
            {"role": "user", "content": "Hello! This is a direct LLM test message."}
        ]
    )

    end = time.time()

    print("\nAssistant Response:\n")
    print(response.choices[0].message["content"])

    print(f"\n⏱ Time Taken (Direct LLM): {end - start:.3f} seconds\n")


if __name__ == "__main__":
    direct_llm_call()


