import requests
from requests.auth import HTTPBasicAuth

url = "https://dev.azure.com/Teva-CCOE/_apis/projects?api-version=7.1"
auth = HTTPBasicAuth('your_email@domain.com', 'your_pat_here')

r = requests.get(url, auth=auth)
print(r.status_code)
print(r.text)
