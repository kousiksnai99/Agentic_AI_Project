ORG=your-azure-devops-organization
PROJECT=your-project-name
REPO=your-repo-name
PAT=your_personal_access_token_here
SOURCE_BRANCH=main        # or 'master' — jisse se branch create karna hai
LOCAL_PS_FILE=sample_script.ps1




import requests
from requests.auth import HTTPBasicAuth

# HARDCODED CONFIG
EMAIL = "your_email@company.com"   # Azure DevOps login email
PAT = "azdXXXXXXXXXXXX"            # PAT with Code Read & Write

# Correct repo URL
REFS_URL = "https://dev.azure.com/Teva-CCOE/_apis/git/repositories/ITOA-Agentic-AI-PROJECT/refs?filter=heads/main&api-version=7.1"
auth = HTTPBasicAuth(EMAIL, PAT)

print("🔹 Testing GET refs for main branch...")
r = requests.get(REFS_URL, auth=auth)

print("Status code:", r.status_code)
print("Response:", r.text)
