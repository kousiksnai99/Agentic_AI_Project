from azure.ai.projects import AIProjectClient
from azure.identity import AzureCliCredential
from azure.ai.agents.models import ListSortOrder
from azure.mgmt.automation import AutomationClient
from datetime import datetime

# -------------------------------
# Azure Configurations
# -------------------------------
AZURE_SUBSCRIPTION_ID = "5e31a9fe-8582-4f44-abd5-0a925d25c818"
AZURE_RESOURCE_GROUP = "aoairg"
AUTOMATION_ACCOUNT = "automationagent"
PROJECT_ENDPOINT = "https://aifoundry-rjteh-ais-swce-poc.services.ai.azure.com/api/projects/aifp-uqqnf-ais-swce-poc"
AGENT_ID = "asst_PJGp1mw7VNLpG0Uwy6ZU7mMW"   # Your agent ID from first code

# -------------------------------
# Credentials (NO tenant/client needed)
# -------------------------------
credential = AzureCliCredential()

# Project Client using CLI Auth
project = AIProjectClient(
    credential=credential,
    endpoint=PROJECT_ENDPOINT
)

# Automation Client using CLI Auth
automation_client = AutomationClient(
    credential=credential,
    subscription_id=AZURE_SUBSCRIPTION_ID
)

# -------------------------------
# Load the Agent
# -------------------------------
agent = project.agents.get_agent(AGENT_ID)

# -------------------------------
# Create a thread
# -------------------------------
thread = project.agents.threads.create()
print(f"Created thread, ID: {thread.id}")

# -------------------------------
# Function: Execute Runbook
# -------------------------------
def execute_runbook(runbook_name):
    try:
        runbooks = automation_client.runbook.list_by_automation_account(
            AZURE_RESOURCE_GROUP, AUTOMATION_ACCOUNT
        )
        available = [rb.name for rb in runbooks]

        if runbook_name not in available:
            return f"Runbook '{runbook_name}' not found."

        job_name = f"job_{runbook_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}"
        job_params = {
            "runbook": {"name": runbook_name},
            "parameters": {}
        }

        job = automation_client.job.create(
            AZURE_RESOURCE_GROUP,
            AUTOMATION_ACCOUNT,
            job_name,
            job_params
        )
        return f"✅ Runbook '{runbook_name}' started successfully. Job ID: {job.job_id}"
    except Exception as e:
        return f"❌ Failed to start runbook '{runbook_name}': {str(e)}"

# -------------------------------
# Function: Chat with Agent
# -------------------------------
def chat_with_agent(user_input):
    project.agents.messages.create(
        thread_id=thread.id,
        role="user",
        content=user_input
    )

    run = project.agents.runs.create_and_process(
        thread_id=thread.id,
        agent_id=agent.id
    )

    if run.status == "failed":
        return f"Run failed: {run.last_error}"

    messages = list(project.agents.messages.list(thread_id=thread.id, order=ListSortOrder.ASCENDING))

    for message in reversed(messages):
        if message.role == "assistant" and message.text_messages:
            response_text = message.text_messages[-1].text.value
            # Simple keyword-based runbook extraction
            for keyword in response_text.split():
                if keyword.startswith("Azure_") or keyword.startswith("Fix-"):
                    runbook_name = keyword.strip(",.")
                    runbook_result = execute_runbook(runbook_name)
                    return f"{response_text}\n\n{runbook_result}"
            return response_text

# -------------------------------
# Chat Loop
# -------------------------------
print("Chat with your agent. Type 'exit' to quit.")
while True:
    user_input = input("You: ").strip()
    if user_input.lower() == "exit":
        break
    response = chat_with_agent(user_input)
    print(f"Agent: {response}")





from azure.ai.projects import AIProjectClient
from azure.identity import DefaultAzureCredential
from azure.ai.agents.models import ListSortOrder

project = AIProjectClient(
    credential=DefaultAzureCredential(),
    endpoint="https://aifoundry-rjteh-ais-swce-poc.services.ai.azure.com/api/projects/aifp-uqqnf-ais-swce-poc")

agent = project.agents.get_agent("asst_MxWLoHuCHSwnPxyZfzUe2EOb")

thread = project.agents.threads.create()
print(f"Created thread, ID: {thread.id}")

message = project.agents.messages.create(
    thread_id=thread.id,
    role="user",
    content="Hi Agentic_AI_POC_Diagnostics_Agent"
)

run = project.agents.runs.create_and_process(
    thread_id=thread.id,
    agent_id=agent.id)

if run.status == "failed":
    print(f"Run failed: {run.last_error}")
else:
    messages = project.agents.messages.list(thread_id=thread.id, order=ListSortOrder.ASCENDING)

    for message in messages:
        if message.text_messages:
            print(f"{message.role}: {message.text_messages[-1].text.value}")
