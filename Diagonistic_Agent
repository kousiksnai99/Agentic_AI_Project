# ========================= Utilities & Validation ===========================
def json_response(payload: Dict[str, Any], status: int = 200) -> func.HttpResponse:
    """Consistent JSON response"""
    return func.HttpResponse(
        body=json.dumps(payload, default=str),
        status_code=status,
        mimetype="application/json",
    )

def validate_request_body(body: Dict[str, Any]) -> Tuple[str, bool, str, Optional[str], str]:
    """
    Expected Schema:
    {
        "issue" : "string, required",
        "execute": true/false, optional, default= true,
        "target_machine" : "string, required" ,
        "session_id" : "string, optional"
        "loggedin_username": "string, required"
    }
    """
    issue = body.get("issue")
    if not isinstance(issue, str) or not issue.strip():
        raise ValueError("Field 'issue' is required and must be a non-empty string.")

    execute = bool(body.get("execute", True))
    target_machine = body.get("target_machine", "").strip() or "UNSPECIFIED"
    session_id = body.get("session_id", None)
    loggedin_username = body.get("loggedin_username", "")
    if not isinstance(target_machine, str):
        raise ValueError("Field 'target_machine' is required and must be a string.")
    if not isinstance(loggedin_username, str) or not loggedin_username.strip():
        raise ValueError("Field 'loggedin_username' is required and must be a non-empty string.")

    return issue.strip(), execute, target_machine, session_id, loggedin_username.strip()

