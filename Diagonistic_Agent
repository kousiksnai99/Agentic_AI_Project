# create_new_runbook helper (adapted from your utils)
def create_new_runbook(runbook_name: str, system_name: str) -> Tuple[Optional[str], Optional[str]]:
    """
    Create a new runbook in the automation account by copying content from existing runbook.
    Returns (job_name, job_id) if executed or (None, None) on error.
    """
    try:
        cfg = get_config()
        credential = get_default_credential()
        client = AutomationClient(credential, cfg.automation.subscription_id)

        timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
        new_runbook_name = f"{runbook_name}_{system_name}_{timestamp}"

        # Attempt: get draft content via SDK
        source_script = None
        try:
            content_stream = client.runbook_draft.get_content(
                resource_group_name=cfg.automation.resource_group,
                automation_account_name=cfg.automation.automation_account,
                runbook_name=runbook_name,
            )
            if hasattr(content_stream, "read"):
                source_script = content_stream.read().decode("utf-8")
            else:
                source_script = str(content_stream)
            logging.info("Draft content retrieved successfully for '%s'", runbook_name)
        except Exception:
            logging.info("Draft not available, trying published content or REST.")

        # Try published content
        if not source_script:
            try:
                content_stream = client.runbook.get_content(
                    resource_group_name=cfg.automation.resource_group,
                    automation_account_name=cfg.automation.automation_account,
                    runbook_name=runbook_name,
                )
                if hasattr(content_stream, "read"):
                    source_script = content_stream.read().decode("utf-8")
                else:
                    source_script = str(content_stream)
                logging.info("Published content retrieved successfully for '%s'", runbook_name)
            except Exception:
                logging.info("Published not available, trying REST fallback.")
                source_script = None

        if not source_script:
            # REST fallback
            helper = AzureautomationService(cfg.automation, credential)
            source_script = helper.fetch_runbook_content(runbook_name)

        if not source_script:
            # generate placeholder
            source_script = (
                f"# Auto-generated Runbook\n# Name: {new_runbook_name}\n# System: {system_name}\n# Created: {timestamp}\n\n"
                f"Write-Output 'Running {new_runbook_name}'\n"
            )
            logging.info("No source found. Using placeholder script for new runbook.")

        # Create runbook and publish & execute
        az_service = AzureautomationService(cfg.automation, credential)
        # prepare annotated content similar to clone method
        header_block = [
            f"# Generated by Agentic Automation Team",
            f"$ScriptName = '{new_runbook_name}'",
            f"$DeviceName = '{system_name}'",
            f"# Created: {timestamp}",
            "$scriptContent = @'",
            source_script,
            "'@",
        ]
        final_content = "\n".join(header_block)
        job_name, job_id = az_service.create_or_update_runbook(new_runbook_name, final_content)
        return job_name, job_id
    except Exception:
        logging.exception("create_new_runbook failed.")
        return None, None

# Pending confirmations used by troubleshooting analyze
PENDING_CONFIRMATIONS: Dict[str, Dict[str, Any]] = {}
PENDING_TTL_SECONDS = int(os.environ.get("PENDING_TTL_SECONDS", "300"))
PENDING_LOCK = None  # thread-safe lock can be used if concurrency is needed

def cleanup_expired_pending():
    now = datetime.utcnow()
    to_delete = []
    for k, v in list(PENDING_CONFIRMATIONS.items()):
        if v.get("expires_at") and v["expires_at"] < now:
            to_delete.append(k)
    for k in to_delete:
        del PENDING_CONFIRMATIONS[k]

# ========================= Azure Function entrypoint =========================
def main(req: func.HttpRequest) -> func.HttpResponse:
    """
    Single Azure Function that routes to:
      POST /diagnostic/chat
      POST /troubleshooting/analyze

    We capture the entire path using a wildcard route parameter (see function.json).
    """
    correlation_id = req.headers.get("x-correlation-id", str(uuid.uuid4()))
    logging.info("Request received for Agentic Automation function. CORRELATIONID = %s", correlation_id)
    time_logger = {}
    try:
        # Parse JSON body
        try:
            time_logger["JSON_Parser_Start"] = datetime.utcnow().isoformat() + "Z"
            request_body = req.get_json()
            time_logger["JSON_Parser_End"] = datetime.utcnow().isoformat() + "Z"
        except ValueError:
            logging.warning("Invalid JSON in request body.")
            return json_response({"Success": False, "error": {"message": "Invalid JSON payload."}}, status=400)

        # Validate required fields (we reuse your validate_request_body)
        try:
            time_logger["Schema_Validation_Start"] = datetime.utcnow().isoformat() + "Z"
            issue, execute, target_machine, session_id, loggedin_username = validate_request_body(request_body)
            time_logger["Schema_Validation_End"] = datetime.utcnow().isoformat() + "Z"
        except ValueError as value_error:
            logging.warning("Request validation failed: %s", value_error)
            return json_response({"Success": False, "error": {"message": str(value_error)}}, status=400)

        # Load configuration
        try:
            time_logger["Config_Start"] = datetime.utcnow().isoformat() + "Z"
            config_obj, foundey_dict, automation_dict = load_config_from_akeyless()
            time_logger["Config_End"] = datetime.utcnow().isoformat() + "Z"
        except Exception as environment_error:
            logging.exception("Configuration loading failed.")
            return json_response({"Success": False, "error": {"message": "Configuration error.", "details": str(environment_error)}}, status=500)

        credential = get_default_credential()
        automation_service = AzureautomationService(config_obj.automation, credential)
        # Foundry service created lazily per call in wrappers (to isolate per-call errors)
        event_logger = EventHubLogger(automation_dict, credential)

        # Route determination - read the path wildcard from route params
        path = req.route_params.get("path", "") or req.url.split(req.route_params.get("function", "") or "")[-1]
        # normalize path - trim leading/trailing slashes
        path = path.strip("/").lower()

        # Log Issue Received
        event_logger.send_event({"event_type": "issue_received", "correlation_id": correlation_id, "environment": config_obj.environment, "target_machine": target_machine, "execute": execute, "timestamp_utc": datetime.utcnow().isoformat() + "Z"})

        # Diagnostic route: diagnostic/chat
        if path == "diagnostic/chat" or path.endswith("/diagnostic/chat"):
            # Resolve runbook using Foundry agent
            runbook_name = diagnostic_process_issue(issue)
            if not runbook_name:
                event_logger.send_event({"event_type": "Runbook Resolution Failed", "correlation_id": correlation_id, "environment": config_obj.environment, "timestamp_utc": datetime.utcnow().isoformat() + "Z"})
                return json_response({"Success": False, "error": {"message": "No Runbook could be resolved for the given issue. Please contact the agentic AI POC team."}}, status=404)

            # Optionally clone and run
            try:
                cloned_name, job_name, job_id = automation_service.clone_runbook_with_metadata(
                    source_runbook_name=runbook_name,
                    system_name=target_machine,
                    issue_text=issue,
                    environment=config_obj.environment,
                    session_id=session_id,
                    loggedin_username=loggedin_username,
                )
            except Exception as unknown_exception:
                logging.exception("Runbook cloning failed.")
                event_logger.send_event({"event_type": "Runbook Clone Failed", "correlation_id": correlation_id, "environment": config_obj.environment, "Original Runbook": runbook_name, "error": str(unknown_exception), "timestamp_utc": datetime.utcnow().isoformat() + "Z"})
                return json_response({"Success": False, "error": {"message": "Runbook cloning or publishing failed.", "details": str(unknown_exception)}}, status=502)

            logging.info("Runbook cloned successfully: %s", cloned_name)
            event_logger.send_event({"event_type": "Runbook cloned successfully", "correlation_id": correlation_id, "environment": config_obj.environment, "Original Runbook": runbook_name, "Cloned_Runbook": cloned_name, "target_machine": target_machine, "timestamp_utc": datetime.utcnow().isoformat() + "Z"})

            return json_response({"Success": True, "original_runbook_name": runbook_name, "cloned_runbook_name": cloned_name, "job_name": job_name, "job_id": job_id, "executed": True, "target_machine": target_machine, "environment": config_obj.environment, "message": "Diagnosis process has been triggered.", "Time_Logger": time_logger}, status=200)

        # Troubleshooting route: troubleshooting/analyze
        elif path == "troubleshooting/analyze" or path.endswith("/troubleshooting/analyze"):
            # cleanup expired
            cleanup_expired_pending()
            runbook_name, full_description = troubleshooting_process_issue(issue)
            if not runbook_name:
                event_logger.send_event({"event_type": "Troubleshoot Resolution Failed", "correlation_id": correlation_id, "environment": config_obj.environment, "timestamp_utc": datetime.utcnow().isoformat() + "Z"})
                return json_response({"Success": False, "error": {"message": "No Runbook could be resolved for troubleshooting."}}, status=404)

            if execute:
                PENDING_CONFIRMATIONS[target_machine] = {"runbook_name": runbook_name, "full_text": full_description, "expires_at": datetime.utcnow() + timedelta(seconds=PENDING_TTL_SECONDS)}

            return json_response({"Success": True, "runbook_name": runbook_name, "full_description": full_description, "execute_pending": execute, "Time_Logger": time_logger}, status=200)

        else:
            return json_response({"Success": False, "error": {"message": f"Unsupported path: {path}"}}, status=404)

    except Exception as unhandled_exception:
        logging.exception("Unhandled exception in agentic automation function.")
        return json_response({"Success": False, "error": {"message": "Unhandled Server error. Please contact the automation team.", "details": str(unhandled_exception)}}, status=500)
