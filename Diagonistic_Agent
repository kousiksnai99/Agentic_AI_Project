# ========================= Azure AI Foundry Agent Service ===========================
class FoundryAgentService:
    """
    Wrapper for interacting with Azure AI Foundry agents.
    """
    def __init__(self, config: FoundryConfig, credential: DefaultAzureCredential):
        self.config = config
        # Use Default credential for production; AzureCliCredential may be used locally
        try:
            self.project = AIProjectClient(endpoint=config.endpoint, credential=credential)
            # Diagnostic agent by id
            self.diagnostic_agent = self.project.agents.get_agent(self.config.diagnostic_agent_id)
            self.troubleshoot_agent = self.project.agents.get_agent(self.config.troubleshoot_agent_id)
        except Exception:
            logging.exception("Failed to initialize Foundry AIProjectClient.")
            raise

    def resolve_runbook_from_issue(self, issue_text: str) -> Tuple[Optional[str], Dict[str, str]]:
        """
        Sends the issue to the diagnostic agent and expects a final message
        that contains the resolved runbook name.
        Returns (resolved_runbook_name, Resolve_Logger)
        """
        Resolve_Logger = {}
        try:
            logging.info("Sending issue to Foundry diagnostic agent.")
            Resolve_Logger["Thread_Start"] = datetime.utcnow().isoformat() + "Z"
            thread = self.project.agents.threads.create()
            Resolve_Logger["Thread_End"] = datetime.utcnow().isoformat() + "Z"

            Resolve_Logger["Message_Start"] = datetime.utcnow().isoformat() + "Z"
            self.project.agents.messages.create(thread_id=thread.id, role="user", content=issue_text)
            Resolve_Logger["Message_End"] = datetime.utcnow().isoformat() + "Z"

            Resolve_Logger["Run_Start"] = datetime.utcnow().isoformat() + "Z"
            run = self.project.agents.runs.create_and_process(thread_id=thread.id, agent_id=self.diagnostic_agent.id)
            Resolve_Logger["Run_End"] = datetime.utcnow().isoformat() + "Z"

            if run.status == "failed":
                logging.error("Foundry run failed.")
                return None, Resolve_Logger

            Resolve_Logger["Order_Start"] = datetime.utcnow().isoformat() + "Z"
            messages = self.project.agents.messages.list(thread_id=thread.id, order=ListSortOrder.ASCENDING)
            Resolve_Logger["Order_End"] = datetime.utcnow().isoformat() + "Z"

            resolved_runbook_name: Optional[str] = None
            Resolve_Logger["Msg_Read_Start"] = datetime.utcnow().isoformat() + "Z"
            for message in messages:
                if getattr(message, "text_messages", None):
                    resolved_runbook_name = message.text_messages[-1].text.value
            Resolve_Logger["Msg_Read_End"] = datetime.utcnow().isoformat() + "Z"

            if resolved_runbook_name:
                logging.info("Foundry diagnostic agent resolved runbook '%s'.", resolved_runbook_name)
            else:
                logging.warning("Foundry diagnostic agent did not return a runbook name.")
            return resolved_runbook_name, Resolve_Logger
        except Exception:
            logging.exception("Exception while resolving runbook via Foundry.")
            return None, Resolve_Logger

    def troubleshoot_runbook_from_issue(self, issue_text: str) -> Tuple[Optional[str], Optional[str], Dict[str, str]]:
        """
        Similar to resolve_runbook_from_issue but uses the troubleshooting agent
        Returns (runbook_name, full_description, logger)
        """
        Resolve_Logger = {}
        try:
            logging.info("Sending issue to Foundry troubleshooting agent.")
            Resolve_Logger["Thread_Start"] = datetime.utcnow().isoformat() + "Z"
            thread = self.project.agents.threads.create()
            Resolve_Logger["Thread_End"] = datetime.utcnow().isoformat() + "Z"

            Resolve_Logger["Message_Start"] = datetime.utcnow().isoformat() + "Z"
            self.project.agents.messages.create(thread_id=thread.id, role="user", content=issue_text)
            Resolve_Logger["Message_End"] = datetime.utcnow().isoformat() + "Z"

            Resolve_Logger["Run_Start"] = datetime.utcnow().isoformat() + "Z"
            run = self.project.agents.runs.create_and_process(thread_id=thread.id, agent_id=self.troubleshoot_agent.id)
            Resolve_Logger["Run_End"] = datetime.utcnow().isoformat() + "Z"

            if run.status == "failed":
                logging.error("Troubleshooting agent run failed.")
                return None, None, Resolve_Logger

            messages = self.project.agents.messages.list(thread_id=thread.id, order=ListSortOrder.ASCENDING)
            runbook_name = None
            full_description = None
            for message in messages:
                if getattr(message, "text_messages", None):
                    # for troubleshooting we expect the agent to return two parts:
                    # first a runbook name and optionally a fuller description in the same or subsequent message.
                    # We'll pick the last text message as full_description, and if text looks like a runbook name, set runbook_name.
                    last_text = message.text_messages[-1].text.value
                    full_description = last_text
                    if not runbook_name:
                        # a simple heuristic: runbook names often look like words_with_underscores or start with "RB_"
                        if "runbook" in last_text.lower() or "_" in last_text or last_text.strip().isidentifier():
                            runbook_name = last_text.strip()
            return runbook_name, full_description, Resolve_Logger
        except Exception:
            logging.exception("Exception while troubleshooting via Foundry.")
            return None, None, Resolve_Logger

